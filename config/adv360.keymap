#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv {
    delay-ms = <10>;
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        TD0: TD0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&none>, <&none>;
        };

        BackspaceDelete: BackspaceDelete {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACEDELETE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
        };

        Space_Tab: Space_Tab {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_TAB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            require-prior-idle-ms = <150>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
        };

        LShift_SpellCheck: LShift_SpellCheck {
            compatible = "zmk,behavior-hold-tap";
            label = "LSHIFT_SPELLCHECK";
            bindings = <&kp>, <&Spelling_Menu>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "hold-preferred";
        };

        RShift_Esc: RShift_Esc {
            compatible = "zmk,behavior-hold-tap";
            label = "RSHIFT_ESC";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        QuestionMark: QuestionMark {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTIONMARK";
            bindings = <&kp QUESTION>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        Sticky_Key: Sticky_Key {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY";
            bindings = <&sk>;
            #binding-cells = <1>;
            quick-release;
            release-after-ms = <1000>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESC>;
            key-positions = <32 41>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        Spelling_Menu {
            bindings = <&Spelling_Menu>;
            key-positions = <41 42>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            layers = <5>;
        };

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <32 31>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        Hyphen {
            bindings = <&kp MINUS>;
            key-positions = <41 42>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        StickyShift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
    };

    macros {
        Spelling_Menu: Spelling_Menu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT &kp LEFT &kp K_CONTEXT_MENU>;
            label = "SPELLING_MENU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&auto_shift LS(EQUAL) EQUAL  &auto_shift LS(N1) N1        &auto_shift LS(N2) N2  &auto_shift LS(N3) N3  &auto_shift LS(N4) N4  &auto_shift LS(N5) N5  &tog 1                                                                                                                                 &mo 3          &auto_shift LS(N6) N6  &auto_shift LS(N7) N7  &auto_shift LS(N8) N8  &auto_shift LS(N9) N9      &auto_shift LS(N0) N0      &auto_shift LS(MINUS) MINUS
&kp TAB                      &kp Q                        &kp W                  &kp E                  &kp R                  &kp T                  &mt LC(LS(V)) LC(V)                                                                                                                    &kp LC(LS(Z))  &kp Y                  &kp U                  &kp I                  &kp O                      &kp P                      &auto_shift LS(BSLH) BSLH
&kp ESCAPE                   &kp A                        &kp S                  &kp D                  &kp F                  &kp G                  &mt LC(X) LC(C)                           &kp LEFT_CONTROL  &kp LEFT_ALT                  &kp LEFT_GUI             &kp RIGHT_CONTROL   &kp LC(Z)      &kp H                  &kp J                  &kp K                  &kp L                      &kp SQT                    &auto_shift LS(SEMICOLON) SEMICOLON
&kp LSHFT                    &kp Z                        &kp X                  &kp C                  &kp V                  &kp B                                                                              &kp HOME                      &kp END                                                     &kp N                  &kp M                  &kp COMMA              &kp DOT                    &QuestionMark              &kp RSHFT
&tog 4                       &auto_shift LS(GRAVE) GRAVE  &kp CAPS               &kp LEFT               &kp RIGHT                                     &BackspaceDelete LC(BACKSPACE) BACKSPACE  &Space_Tab 4 TAB  &Sticky_Key LEFT_CONTROL      &Sticky_Key RIGHT_SHIFT  &Space_Tab 5 ENTER  &kp SPACE                             &kp UP                 &kp DOWN               &auto_shift LS(LBKT) LBKT  &auto_shift LS(RBKT) RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                 &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp ESC    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                  &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp TAB    &kp A      &kp S     &kp D     &kp F      &kp G   &none   &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                      &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &trans  &trans     &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        Mouse {
            bindings = <
&kp F1  &kp F2          &kp F3          &kp F4             &kp F5           &kp F6            &trans                                      &trans     &kp F7      &kp F8           &kp F9          &kp F10          &kp F11          &kp F12
&trans  &mkp MB5        &mkp MCLK       &msc SCRL_UP       &mkp MB4         &kp C_PREVIOUS    &trans                                      &trans     &kp C_NEXT  &kp K_BACK       &mmv MOVE_UP    &kp K_FORWARD    &kp PRINTSCREEN  &kp C_BRIGHTNESS_INC
&trans  &kp LEFT_SHIFT  &msc SCRL_LEFT  &msc SCRL_DOWN     &msc SCRL_RIGHT  &kp C_PLAY_PAUSE  &trans  &trans  &trans      &trans  &trans  &trans     &kp LG(E)   &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp RCLK        &kp C_BRIGHTNESS_DEC
&trans  &trans          &kp C_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans                            &trans      &trans                     &trans      &kp LS(LC(TAB))  &trans          &kp LC(TAB)      &trans           &trans
&trans  &trans          &trans          &trans             &trans                             &trans  &trans  &trans      &trans  &trans  &mkp LCLK              &trans           &trans          &trans           &trans           &trans
            >;
        };

        ArrowKeys {
            bindings = <
&trans  &trans              &trans          &trans            &trans          &trans        &trans                                                                  &trans  &trans    &trans       &trans         &trans     &trans   &trans
&trans  &trans              &Spelling_Menu  &kp ENTER         &kp SPACE       &kp TAB       &trans                                                                  &trans  &trans    &trans       &kp UP         &trans     &trans   &trans
&trans  &kp K_CONTEXT_MENU  &kp LEFT_ALT    &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_GUI  &trans                              &trans  &trans      &trans  &trans  &trans  &kp HOME  &kp LEFT     &kp DOWN       &kp RIGHT  &kp END  &trans
&trans  &trans              &kp LC(X)       &kp LC(C)         &kp LC(V)       &trans                                                    &trans      &trans                  &trans    &kp PAGE_UP  &kp PAGE_DOWN  &trans     &trans   &trans
&trans  &trans              &trans          &trans            &trans                        &BackspaceDelete LC(DELETE) DELETE  &trans  &trans      &trans  &trans  &trans            &trans       &trans         &trans     &trans   &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
